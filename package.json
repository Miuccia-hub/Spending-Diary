{
  "name": "liuxue-spending-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:local": "concurrently --kill-others-on-fail --names build,worker --prefix-colors magenta,cyan \"vite build --watch\" \"wrangler dev --port 8787\"",
    "preview:cloudflare": "pnpm run build && wrangler dev --remote --port 8787",
    "check:cloudflare": "pnpm run build && wrangler deploy --dry-run",
    "deploy:cloudflare": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@netlify/blobs": "^9.1.0",
    "@netlify/functions": "^4.1.0",
    "@netlify/identity": "^1.2.0",
    "heic2any": "^0.0.4",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "vite": "^7.1.3",
    "wrangler": "4.123.0"
  }
}
