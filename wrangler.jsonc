{
  "$schema": "https://unpkg.com/wrangler@4.123.0/config-schema.json",
  "name": "liuxue-spending-diary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liuxue-spending-diary",
      "database_id": "a0dd4f06-4c19-4dfb-8e80-ad79b2d6049b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "liuxue-spending-receipts"
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  "observability": { "enabled": true }
}
